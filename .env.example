# Development Environment Variables
# Copy this file to .env and modify as needed

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Drizzle
